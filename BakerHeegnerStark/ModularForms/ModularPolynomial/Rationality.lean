import BakerHeegnerStark.FieldTheory.Cyclotomic
import BakerHeegnerStark.ModularForms.QExpansion.CyclotomicPowerSeries
import BakerHeegnerStark.ModularForms.ModularPolynomial.Integrality

/-!
# Arithmetic Descent of the Actual Modular Polynomial

The common-width coefficient series are defined over the concrete cyclotomic
field generated by the actual translation phase. Its Galois group reindexes
the actual factors. Unit triangular q-regularization transfers this fixedness
to the coefficient polynomials in `j`, giving rational coefficients.
-/

open UpperHalfPlane ModularForm Polynomial
open scoped Polynomial.Bivariate

noncomputable section

namespace BakerHeegnerStark

/-- A bounded-degree polynomial representing an actual symmetric coefficient
is defined over `ℚ`, by finite cyclotomic Galois descent of its full q-series. -/
theorem exists_rational_polynomial_cyclicSublatticePolynomial_repr
    {N : ℕ} (hN : 0 < N) (k : ℕ) (P : ℂ[X])
    (hdeg : P.natDegree ≤ N * (cyclicSublatticeTriples N).card)
    (hrep : ∀ τ : UpperHalfPlane,
      (cyclicSublatticePolynomial N τ).coeff k = P.eval (jInvariant τ)) :
    ∃ Q : ℚ[X], Q.map (algebraMap ℚ ℂ) = P := by
  let K := cyclicSublatticeCyclotomicField N
  let ξ : K := cyclicSublatticeCyclotomicRoot N
  let f : K →+* ℂ := algebraMap K ℂ
  let n := N * (cyclicSublatticeTriples N).card
  let s := N * n - cyclicSublatticeTotalPoleOrder N
  let J : PowerSeries K := PowerSeries.expand N (Nat.ne_of_gt hN)
    (PowerSeries.map (Int.castRingHom K) jInvariantIntegralNumerator)
  let A : PowerSeries K := PowerSeries.X ^ s * (cyclotomicQPolynomial hN ξ).coeff k
  have hJ : J.constantCoeff = 1 := by
    rw [PowerSeries.constantCoeff_expand, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
      PowerSeries.coeff_map, PowerSeries.coeff_zero_eq_constantCoeff,
      jInvariantIntegralNumerator_constantCoeff, map_one]
  have hmapIntJ : PowerSeries.map f
      (PowerSeries.map (Int.castRingHom K) jInvariantIntegralNumerator) =
      PowerSeries.map (Int.castRingHom ℂ) jInvariantIntegralNumerator := by
    ext m
    simp
  have hmapJ : PowerSeries.map f J = PowerSeries.expand N (Nat.ne_of_gt hN)
      (PowerSeries.map (Int.castRingHom ℂ) jInvariantIntegralNumerator) := by
    rw [PowerSeries.map_expand, hmapIntJ]
  have hmapB : PowerSeries.map f ((cyclotomicQPolynomial hN ξ).coeff k) =
      (cyclicSublatticeQPolynomial hN).coeff k := by
    have hm := map_cyclotomicQPolynomial hN f ξ
    rw [show f ξ = cyclicSublatticePhase 1 N from rfl,
      cyclotomicQPolynomial_complex] at hm
    simpa only [Polynomial.coeff_map] using congrArg (fun p : (PowerSeries ℂ)[X] => p.coeff k) hm
  have hreg : P.qRegularization (PowerSeries.map f J) N n = PowerSeries.map f A := by
    rw [hmapJ, qRegularization_cyclicSublatticePolynomial_repr hN k P hdeg hrep]
    simp only [A, map_mul, map_pow, PowerSeries.map_X, hmapB, s, n]
  obtain ⟨PK, hPK⟩ := Polynomial.exists_map_of_qRegularization_eq_map
    f P J hJ N n hN hdeg A hreg
  have hdegK : PK.natDegree ≤ n := by
    rw [← Polynomial.natDegree_map_eq_of_injective f.injective PK, hPK]
    exact hdeg
  have hregK : PK.qRegularization J N n = A := by
    apply PowerSeries.map_injective f f.injective
    calc
      PowerSeries.map f (PK.qRegularization J N n) =
          (PK.map f).qRegularization (PowerSeries.map f J) N n :=
        (Polynomial.qRegularization_map PK J N n f).symm
      _ = PowerSeries.map f A := by rw [hPK, hreg]
  have hξ : ξ ^ N = 1 := (isPrimitiveRoot_cyclicSublatticeCyclotomicRoot hN).pow_eq_one
  have hfixed (σ : K ≃ₐ[ℚ] K) : PK.map σ.toRingHom = PK := by
    have hσJ : PowerSeries.map σ.toRingHom J = J := by
      rw [PowerSeries.map_expand]
      congr 1
      ext m
      simp
    obtain ⟨u, hu, hσξ⟩ := exists_coprime_cyclicSublatticeCyclotomicRoot_aut hN σ
    have hσpoly := map_cyclotomicQPolynomial_eq_self hN ξ hξ σ.toRingHom u hu hσξ
    have hσB : PowerSeries.map σ.toRingHom ((cyclotomicQPolynomial hN ξ).coeff k) =
        (cyclotomicQPolynomial hN ξ).coeff k := by
      simpa only [Polynomial.coeff_map] using
        congrArg (fun p : (PowerSeries K)[X] => p.coeff k) hσpoly
    have hσA : PowerSeries.map σ.toRingHom A = A := by
      simp only [A, map_mul, map_pow, PowerSeries.map_X, hσB]
    apply Polynomial.map_eq_of_qRegularization_fixed PK J hJ N n hN hdegK σ.toRingHom hσJ
    rw [hregK]
    exact hσA
  let : FiniteDimensional ℚ K := finiteDimensional_cyclicSublatticeCyclotomicField hN
  let : IsGalois ℚ K := isGalois_cyclicSublatticeCyclotomicField hN
  have hcoeff : ∀ i, PK.coeff i ∈ (algebraMap ℚ K).range := by
    intro i
    apply (IsGalois.mem_range_algebraMap_iff_fixed (F := ℚ) (E := K) (PK.coeff i)).mpr
    intro σ
    have hm := congrArg (fun p : K[X] => p.coeff i) (hfixed σ)
    rw [Polynomial.coeff_map] at hm
    exact hm
  obtain ⟨Q, hQ⟩ : ∃ Q : ℚ[X], Q.map (algebraMap ℚ K) = PK :=
    (Polynomial.mem_map_range (algebraMap ℚ K)).mpr hcoeff
  refine ⟨Q, ?_⟩
  rw [IsScalarTower.algebraMap_eq ℚ K ℂ, ← Polynomial.map_map, hQ]
  exact hPK

/-- Rationality and algebraic integrality descend the actual coefficient
polynomial all the way to `ℤ`. -/
theorem exists_integer_polynomial_cyclicSublatticePolynomial_repr
    {N : ℕ} (hN : 0 < N) (k : ℕ) (P : ℂ[X])
    (hdeg : P.natDegree ≤ N * (cyclicSublatticeTriples N).card)
    (hrep : ∀ τ : UpperHalfPlane,
      (cyclicSublatticePolynomial N τ).coeff k = P.eval (jInvariant τ)) :
    ∃ Q : ℤ[X], Q.map (Int.castRingHom ℂ) = P := by
  obtain ⟨Q, hQ⟩ := exists_rational_polynomial_cyclicSublatticePolynomial_repr hN k P hdeg hrep
  have hInt := isIntegral_coeff_of_cyclicSublatticePolynomial_repr hN k P hdeg hrep
  apply (Polynomial.mem_map_range (Int.castRingHom ℂ)).mpr
  intro i
  have hmap : algebraMap ℚ ℂ (Q.coeff i) = P.coeff i := by
    simpa only [Polynomial.coeff_map] using congrArg (fun p : ℂ[X] => p.coeff i) hQ
  have hcomplex : IsIntegral ℤ (algebraMap ℚ ℂ (Q.coeff i)) := hmap.symm ▸ hInt i
  have hrat : IsIntegral ℤ (Q.coeff i) := isIntegral_algebraMap_iff.mp hcomplex
  obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hrat
  refine ⟨z, ?_⟩
  calc
    (Int.castRingHom ℂ) z = algebraMap ℚ ℂ (algebraMap ℤ ℚ z) := by simp
    _ = algebraMap ℚ ℂ (Q.coeff i) := by rw [hz]
    _ = P.coeff i := hmap

/-- Each actual symmetric coefficient is an integer polynomial in the actual
j-value, with no modular polynomial or CM hypothesis. -/
theorem exists_integer_polynomial_cyclicSublatticePolynomial_coeff
    {N : ℕ} (hN : 0 < N) (k : ℕ) :
    ∃ Q : ℤ[X], ∀ τ : UpperHalfPlane,
      (cyclicSublatticePolynomial N τ).coeff k =
        (Q.map (Int.castRingHom ℂ)).eval (jInvariant τ) := by
  obtain ⟨P, hdeg, hrep, _⟩ := exists_integral_polynomial_cyclicSublatticePolynomial_coeff hN k
  obtain ⟨Q, hQ⟩ := exists_integer_polynomial_cyclicSublatticePolynomial_repr hN k P hdeg hrep
  refine ⟨Q, fun τ => ?_⟩
  rw [hQ]
  exact hrep τ

/-- The actual general modular polynomial has integer coefficients and its
full cyclic-sublattice product formula. The nonsquare diagonal leading-unit
assertion is proved separately in `ModularForms/ModularPolynomial/Diagonal.lean`. -/
theorem exists_integer_modularPolynomial {N : ℕ} (hN : 0 < N) :
    ∃ Φ : ℤ[X][Y], ∀ τ : UpperHalfPlane,
      Polynomial.aevalAeval (Polynomial.C (ModularForm.jInvariant τ)) Polynomial.X Φ =
        cyclicSublatticePolynomial N τ := by
  classical
  have hcoeff (k : ℕ) := exists_integer_polynomial_cyclicSublatticePolynomial_coeff hN k
  choose Q hQ using hcoeff
  refine ⟨∑ k ∈ Finset.range ((cyclicSublatticeTriples N).card + 1),
    C (Q k) * X ^ k, fun τ => ?_⟩
  simp only [map_sum, map_mul, map_pow, aevalAeval_C, aevalAeval_Y]
  rw [(cyclicSublatticePolynomial N τ).as_sum_range_C_mul_X_pow,
    natDegree_cyclicSublatticePolynomial]
  apply Finset.sum_congr rfl
  intro k _
  change (Q k).eval₂ (algebraMap ℤ ℂ[X]) (C (jInvariant τ)) * X ^ k =
    C ((cyclicSublatticePolynomial N τ).coeff k) * X ^ k
  have hbase : algebraMap ℤ ℂ[X] =
      (C : ℂ →+* ℂ[X]).comp (Int.castRingHom ℂ) := RingHom.ext_int _ _
  rw [hbase, ← Polynomial.eval₂_map (Int.castRingHom ℂ) (C : ℂ →+* ℂ[X])
    (C (jInvariant τ)), Polynomial.eval₂_at_apply, ← hQ k τ]

end BakerHeegnerStark
