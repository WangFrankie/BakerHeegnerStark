import BakerHeegnerStark.ModularForms.Weber.CoefficientConjugation
import Mathlib.NumberTheory.Cyclotomic.Gal

/-!
# The actual Weber phase field

The concrete field `ℚ(zeta48²) ⊆ ℂ` is the twenty-fourth cyclotomic extension.
Consequently it is finite Galois over `ℚ`, and every `ℚ`-automorphism of `ℂ`
restricts to it. The existing cyclotomic character is injective and describes
this restriction on the actual complex phase. No algebraicity assumption on
`ℂ / ℚ`, or statement about automorphisms of CM values, is used.
-/

open BakerHeegnerStark Complex

noncomputable section
namespace ModularForm

/-- The field generated by the actual Weber phase is cyclotomic of level twenty-four.
The intermediate-field criterion uses algebraicity of the primitive generator only,
not algebraicity of the ambient complex field. -/
instance isCyclotomicExtension_weberBranchCoefficientField :
    IsCyclotomicExtension {24} ℚ weberBranchCoefficientField := by
  have hphase := isPrimitiveRoot_weberBranchPhase.map_of_injective
    (FaithfulSMul.algebraMap_injective weberBranchCoefficientField ℂ)
  exact (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    24 ℚ ℂ weberBranchCoefficientField hphase).mpr rfl

/-- The actual Weber coefficient field is finite-dimensional over the rationals. -/
instance finiteDimensional_weberBranchCoefficientField :
    FiniteDimensional ℚ weberBranchCoefficientField :=
  IsCyclotomicExtension.finiteDimensional {24} ℚ weberBranchCoefficientField

/-- The actual Weber coefficient field is Galois over the rationals. -/
instance isGalois_weberBranchCoefficientField :
    IsGalois ℚ weberBranchCoefficientField :=
  IsCyclotomicExtension.isGalois {24} ℚ weberBranchCoefficientField

/-- An automorphism of the actual coefficient field is determined by its phase exponent. -/
theorem weberBranchCyclotomicCharacter_injective :
    Function.Injective weberBranchCyclotomicCharacter :=
  isPrimitiveRoot_weberBranchPhase.autToPow_injective ℚ

/-- Restriction of an ambient rational automorphism to the normal actual phase field. -/
def weberBranchCoefficientAut (σ : ℂ ≃ₐ[ℚ] ℂ) :
    weberBranchCoefficientField ≃ₐ[ℚ] weberBranchCoefficientField :=
  σ.restrictNormal weberBranchCoefficientField

/-- Restriction agrees with the ambient automorphism under the chosen complex embedding. -/
@[simp]
theorem coe_weberBranchCoefficientAut (σ : ℂ ≃ₐ[ℚ] ℂ)
    (x : weberBranchCoefficientField) :
    (weberBranchCoefficientAut σ x : ℂ) = σ (x : ℂ) :=
  AlgEquiv.restrictNormal_commutes σ weberBranchCoefficientField x

/-- The character of the restricted automorphism controls the actual complex phase. -/
theorem weberBranchCoefficientAut_character_spec (σ : ℂ ≃ₐ[ℚ] ℂ) :
    (zeta48 ^ 2) ^
        (weberBranchCyclotomicCharacter (weberBranchCoefficientAut σ) : ZMod 24).val =
      σ (zeta48 ^ 2) := by
  have h := congrArg (algebraMap weberBranchCoefficientField ℂ)
    (weberBranchCyclotomicCharacter_spec (weberBranchCoefficientAut σ))
  simpa only [map_pow, IntermediateField.algebraMap_apply, coe_weberBranchPhase,
    coe_weberBranchCoefficientAut] using h

end ModularForm
