import BakerHeegnerStark.ComplexMultiplication.Weber.JointRationality
import BakerHeegnerStark.ComplexMultiplication.Weber.JointCM

/-!
# Galois specialization of rational joint modular relations

Rational trivariate coefficients specialized at the actual j-value are fixed by
every automorphism over its generated field. Both the auxiliary variable and the
root variable remain formal. This is finite polynomial algebra and does not
apply an arbitrary automorphism to a convergent analytic sum.

Together with the actual joint relation and CM neighbouring kernels, this
gives the Weber class-invariant case directly. No general Shimura reciprocity
theorem is assumed or asserted here.

## References

For the classical reciprocity interpretation, see A. Enge and F. Morain,
*Generalised Weber Functions*, version 1.0 (2009), §2, Theorem 2
(proper ideals of nonmaximal orders):
<https://www.lix.polytechnique.fr/~morain/Articles/weber0417.pdf>.
-/

open Polynomial
open scoped IntermediateField

noncomputable section
namespace ModularForm

/-- Rational trivariate specialization at `j(τ)` is fixed by every actual
coefficient automorphism over its j-generated field. Both other variables stay formal. -/
theorem map_rational_trivariate_jInvariant (τ : UpperHalfPlane)
    (Φ : ℚ[X][X][X]) (σ : ℂ ≃ₐ[ℚ⟮jInvariant τ⟯] ℂ) :
    (Φ.map (Polynomial.mapRingHom
      (Polynomial.eval₂RingHom (algebraMap ℚ ℂ) (jInvariant τ)))).map
      (Polynomial.mapRingHom σ.toRingHom) =
    Φ.map (Polynomial.mapRingHom
      (Polynomial.eval₂RingHom (algebraMap ℚ ℂ) (jInvariant τ))) := by
  let E : ℚ[X] →+* ℂ := Polynomial.eval₂RingHom (algebraMap ℚ ℂ) (jInvariant τ)
  have hj : σ (jInvariant τ) = jInvariant τ :=
    σ.commutes ⟨jInvariant τ, IntermediateField.mem_adjoin_simple_self ℚ _⟩
  have hQ : σ.toRingHom.comp (algebraMap ℚ ℂ) = algebraMap ℚ ℂ := by
    apply RingHom.ext
    intro q
    exact (σ.restrictScalars ℚ).commutes q
  have hE : σ.toRingHom.comp E = E := by
    apply Polynomial.ringHom_ext'
    · simp only [E, RingHom.comp_assoc, Polynomial.eval₂RingHom_comp_C, hQ]
    · rw [RingHom.comp_apply, show E X = jInvariant τ from Polynomial.eval₂_X _ _]
      exact hj
  have hT : (Polynomial.mapRingHom σ.toRingHom).comp (Polynomial.mapRingHom E) =
      Polynomial.mapRingHom E := by
    apply RingHom.ext
    intro P
    apply Polynomial.ext
    intro n
    simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.coeff_map]
    exact RingHom.congr_fun hE (P.coeff n)
  change (Φ.map (Polynomial.mapRingHom E)).map (Polynomial.mapRingHom σ.toRingHom) = _
  rw [Polynomial.map_map, hT]

/-- An actual rational trivariate representation makes the entire joint CM
polynomial fixed, without passing an automorphism through any infinite sum. -/
theorem weberJointPolynomial_map_eq_of_rational_representation (a : ℕ) (τ : UpperHalfPlane)
    (Φ : ℚ[X][X][X])
    (hΦ : Φ.map (Polynomial.mapRingHom
      (Polynomial.eval₂RingHom (algebraMap ℚ ℂ) (jInvariant τ))) = weberJointPolynomial a τ)
    (σ : ℂ ≃ₐ[ℚ⟮jInvariant τ⟯] ℂ) :
    (weberJointPolynomial a τ).map (Polynomial.mapRingHom σ.toRingHom) =
      weberJointPolynomial a τ := by
  rw [← hΦ]
  exact map_rational_trivariate_jInvariant τ Φ σ

end ModularForm

namespace BakerHeegnerStark

open ModularForm

/-- The actual rational joint relation and the actual CM action put the
normalized Weber square in the field generated by the CM j-value. -/
theorem weberF_sq_sqrtPoint_mem_adjoin
    {m : ℕ} (hm : 0 < m) (hm8 : m % 8 = 3) (hm3 : ¬ 3 ∣ m) :
    weberF ((Real.sqrt m : ℂ) * Complex.I) ^ 2 ∈
      ℚ⟮jInvariant (sqrtPoint m)⟯ := by
  apply weberF_sq_sqrtPoint_mem_adjoin_of_jointPolynomial_fixed hm hm8 hm3
  intro a σ _
  obtain ⟨Φ, hΦ⟩ := exists_rational_weberJointPolynomial a
  exact weberJointPolynomial_map_eq_of_rational_representation
    a (sqrtPoint m) Φ (hΦ (sqrtPoint m)) σ

end BakerHeegnerStark
