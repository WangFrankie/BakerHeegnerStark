import BakerHeegnerStark.EllipticFunctions.PeriodLattice.Basic
import QuadraticNumberFields.ZOnePlusSqrtdOverTwo.Basic
import Mathlib.Algebra.Ring.Hom.InjSurj

/-!
# The Half-Integral Quadratic Order

For `-p = 1 + 4k`, QNF's model `ZOnePlusSqrtdOverTwo k` realizes the period
module generated by `1` and `(1+i√p)/2`. The smaller square-root order embeds
by `√-p ↦ 2ω-1`. These statements are about the actual two order models;
identifying the larger order with the full ring of integers additionally
requires the squarefree hypothesis and QNF's ring-of-integers classification.
-/

open scoped Pointwise QuadraticAlgebra

namespace BakerHeegnerStark

/-- The half-integral complex period satisfies the defining monic relation
of QNF's half-integer order. -/
theorem halfPeriod_quadratic (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    let τ : ℂ := (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2
    τ ^ 2 = (k : ℂ) + τ := by
  dsimp only
  have hs : ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) ^ 2 = -(p : ℂ) := by
    rw [mul_pow, Complex.I_sq, ← Complex.ofReal_pow, Real.sq_sqrt (Nat.cast_nonneg p)]
    push_cast
    ring
  have hkc : -(p : ℂ) = 1 + 4 * (k : ℂ) := by exact_mod_cast hk
  linear_combination (1 / 4 : ℂ) * hs + (1 / 4 : ℂ) * hkc

/-- The faithful branch of the complex realization of QNF's half-integer order. -/
noncomputable def halfOrderEmbedding (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    ZOnePlusSqrtdOverTwo k →ₐ[ℤ] ℂ :=
  QuadraticAlgebra.lift ⟨(1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2, by
    simpa [Algebra.smul_def, pow_two] using halfPeriod_quadratic p k hk⟩

/-- The realization uses the actual two integer coordinates of the order model. -/
theorem halfOrderEmbedding_apply (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (z : ZOnePlusSqrtdOverTwo k) :
    halfOrderEmbedding p k hk z = (z.re : ℂ) + (z.im : ℂ) *
      ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2) := by
  simp [halfOrderEmbedding, QuadraticAlgebra.lift, Algebra.smul_def]

/-- The distinguished half-integer root goes to the chosen complex half-period. -/
theorem halfOrderEmbedding_omega (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    halfOrderEmbedding p k hk QuadraticAlgebra.omega =
      (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2 := by
  simp [halfOrderEmbedding_apply]

/-- The image of the half-integer order is exactly its period module. -/
theorem mem_halfOrderEmbedding_range_iff (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (α : ℂ) :
    α ∈ (halfOrderEmbedding p k hk).toRingHom.range ↔
      α ∈ periodModule ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2) := by
  constructor
  · rintro ⟨z, rfl⟩
    exact (mem_periodModule_iff _ _).mpr ⟨z.re, z.im, halfOrderEmbedding_apply p k hk z⟩
  · intro h
    obtain ⟨m, n, hα⟩ := (mem_periodModule_iff _ α).mp h
    refine ⟨⟨m, n⟩, ?_⟩
    change halfOrderEmbedding p k hk (⟨m, n⟩ : ZOnePlusSqrtdOverTwo k) = α
    rw [halfOrderEmbedding_apply, hα]

/-- The half-integer realization is injective; its parameter relation already
forces `p > 0`. -/
theorem halfOrderEmbedding_injective (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    Function.Injective (halfOrderEmbedding p k hk) := by
  have hp : 0 < p := by omega
  have him : ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2).im ≠ 0 := by
    have hs := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hp : (0 : ℝ) < (p : ℝ))
    simpa using ne_of_gt (div_pos hs (by norm_num : (0 : ℝ) < 2))
  intro x y h
  rw [halfOrderEmbedding_apply, halfOrderEmbedding_apply] at h
  have hxy := periodModule_coordinates_eq _ him h
  exact QuadraticAlgebra.ext hxy.1 hxy.2

/-- The actual inclusion of the square-root order in the half-integer order. -/
noncomputable def sqrtOrderToHalfOrder (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    QuadraticNumberFields.Zsqrtd (-(p : ℤ)) →ₐ[ℤ] ZOnePlusSqrtdOverTwo k := by
  let w : ZOnePlusSqrtdOverTwo k := QuadraticAlgebra.omega
  have hω : w ^ 2 = (k : ZOnePlusSqrtdOverTwo k) + w := by
    rw [QuadraticAlgebra.omega_pow_two_eq_add]
    simp [w, Algebra.smul_def]
  have hkr : ((-(p : ℤ) : ℤ) : ZOnePlusSqrtdOverTwo k) =
      1 + 4 * (k : ZOnePlusSqrtdOverTwo k) := by exact_mod_cast hk
  refine QuadraticAlgebra.lift ⟨2 * w - 1, ?_⟩
  simp only [Algebra.smul_def, mul_one, map_zero, zero_mul, add_zero]
  linear_combination 4 * hω - hkr

/-- The suborder inclusion sends `m+n√-p` to `m+n(2ω-1)`. -/
theorem sqrtOrderToHalfOrder_apply (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (z : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) :
    sqrtOrderToHalfOrder p k hk z = (z.re : ZOnePlusSqrtdOverTwo k) +
      (z.im : ZOnePlusSqrtdOverTwo k) * (2 * QuadraticAlgebra.omega - 1) := by
  simp [sqrtOrderToHalfOrder, QuadraticAlgebra.lift, Algebra.smul_def]

/-- The two concrete complex realizations commute with the actual suborder inclusion. -/
theorem halfOrderEmbedding_comp_sqrtOrderToHalfOrder (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) (z : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) :
    halfOrderEmbedding p k hk (sqrtOrderToHalfOrder p k hk z) = sqrtOrderEmbedding p z := by
  rw [sqrtOrderToHalfOrder_apply, map_add, map_mul, map_sub, map_mul, map_intCast,
    map_intCast, map_ofNat, map_one, halfOrderEmbedding_omega, sqrtOrderEmbedding_apply]
  ring

/-- The actual suborder homomorphism is injective. -/
theorem sqrtOrderToHalfOrder_injective (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    Function.Injective (sqrtOrderToHalfOrder p k hk) := by
  intro x y h
  apply sqrtOrderEmbedding_injective p (by omega)
  simpa only [halfOrderEmbedding_comp_sqrtOrderToHalfOrder] using
    congrArg (halfOrderEmbedding p k hk) h

/-- The two integer coordinates of the actual suborder inclusion. -/
theorem sqrtOrderToHalfOrder_coordinates (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (z : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) :
    (sqrtOrderToHalfOrder p k hk z).re = z.re - z.im ∧
      (sqrtOrderToHalfOrder p k hk z).im = 2 * z.im := by
  rw [sqrtOrderToHalfOrder_apply]
  constructor <;> simp [mul_comm, sub_eq_add_neg]

/-- The square-root suborder consists exactly of half-order elements with
even second coordinate. -/
theorem mem_sqrtOrderToHalfOrder_range_iff (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) (z : ZOnePlusSqrtdOverTwo k) :
    z ∈ (sqrtOrderToHalfOrder p k hk).toRingHom.range ↔ Even z.im := by
  constructor
  · rintro ⟨x, rfl⟩
    refine ⟨x.im, ?_⟩
    change (sqrtOrderToHalfOrder p k hk x).im = x.im + x.im
    rw [(sqrtOrderToHalfOrder_coordinates p k hk x).2]
    ring
  · rintro ⟨n, hn⟩
    refine ⟨⟨z.re + n, n⟩, ?_⟩
    change sqrtOrderToHalfOrder p k hk
      (⟨z.re + n, n⟩ : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) = z
    apply QuadraticAlgebra.ext
    · rw [(sqrtOrderToHalfOrder_coordinates p k hk _).1]
      simp
    · rw [(sqrtOrderToHalfOrder_coordinates p k hk _).2]
      change 2 * n = z.im
      omega

/-- Elements of the half-order that multiply the whole half-order into the
square-root suborder have even coordinates. This is the conductor condition. -/
theorem halfOrder_conductor_iff_even_coordinates (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) (z : ZOnePlusSqrtdOverTwo k) :
    (∀ w : ZOnePlusSqrtdOverTwo k,
      z * w ∈ (sqrtOrderToHalfOrder p k hk).toRingHom.range) ↔
      Even z.re ∧ Even z.im := by
  constructor
  · intro h
    have hz : Even z.im := (mem_sqrtOrderToHalfOrder_range_iff p k hk z).mp (by
      simpa using h 1)
    have hω := (mem_sqrtOrderToHalfOrder_range_iff p k hk _).mp
      (h QuadraticAlgebra.omega)
    obtain ⟨n, hn⟩ := hz
    obtain ⟨m, hm⟩ := hω
    simp only [QuadraticAlgebra.im_mul, QuadraticAlgebra.re_omega,
      QuadraticAlgebra.im_omega, mul_one, mul_zero, one_mul, add_zero] at hm
    exact ⟨⟨m - n, by omega⟩, ⟨n, hn⟩⟩
  · rintro ⟨⟨m, hm⟩, ⟨n, hn⟩⟩ w
    apply (mem_sqrtOrderToHalfOrder_range_iff p k hk _).mpr
    refine ⟨m * w.im + n * w.re + n * w.im, ?_⟩
    simp only [QuadraticAlgebra.im_mul, one_mul, hm, hn]
    ring

/-- The conductor of the actual square-root suborder in the half-integer
order is the principal ideal generated by two. -/
theorem halfOrder_conductor_iff_mem_two (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) (z : ZOnePlusSqrtdOverTwo k) :
    (∀ w : ZOnePlusSqrtdOverTwo k,
      z * w ∈ (sqrtOrderToHalfOrder p k hk).toRingHom.range) ↔
      z ∈ (Ideal.span {2} : Ideal (ZOnePlusSqrtdOverTwo k)) := by
  rw [halfOrder_conductor_iff_even_coordinates, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨⟨m, hm⟩, ⟨n, hn⟩⟩
    refine ⟨⟨m, n⟩, ?_⟩
    apply QuadraticAlgebra.ext <;> simp [hm, hn, two_mul]
  · rintro ⟨w, rfl⟩
    constructor
    · exact ⟨w.re, by simp [two_mul]⟩
    · exact ⟨w.im, by simp [two_mul]⟩

/-- The realized square-root order is a subring of the realized half-integer order. -/
theorem sqrtOrder_halfOrder_range_le (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    (sqrtOrderEmbedding p).toRingHom.range ≤ (halfOrderEmbedding p k hk).toRingHom.range := by
  rintro z ⟨x, rfl⟩
  refine ⟨sqrtOrderToHalfOrder p k hk x, ?_⟩
  exact halfOrderEmbedding_comp_sqrtOrderToHalfOrder p k hk x

/-- The two faithful complex order images have relative additive index two. -/
theorem sqrtOrder_halfOrder_relIndex (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    (sqrtOrderEmbedding p).toRingHom.range.toAddSubgroup.relIndex
      (halfOrderEmbedding p k hk).toRingHom.range.toAddSubgroup = 2 := by
  let s : ℂ := (Real.sqrt (p : ℝ) : ℂ) * Complex.I
  have hsmall : (sqrtOrderEmbedding p).toRingHom.range.toAddSubgroup =
      (periodModule s).toAddSubgroup := by
    ext z
    exact mem_sqrtOrderEmbedding_range_iff p z
  have hlarge : (halfOrderEmbedding p k hk).toRingHom.range.toAddSubgroup =
      (periodModule ((1 + s) / 2)).toAddSubgroup := by
    ext z
    exact mem_halfOrderEmbedding_range_iff p k hk z
  have hp : 0 < p := by omega
  have him : ((1 + s) / 2).im ≠ 0 := by
    have hs : 0 < s.im := by
      simpa [s] using Real.sqrt_pos.mpr (Nat.cast_pos.mpr hp : (0 : ℝ) < (p : ℝ))
    simpa using ne_of_gt (div_pos hs (by norm_num : (0 : ℝ) < 2))
  have heq : (-1 : ℂ) + 2 * ((1 + s) / 2) = s := by ring
  rw [hsmall, hlarge]
  simpa [heq] using periodModule_affine_relIndex ((1 + s) / 2) him (-1) 2 (by norm_num)

/-- The actual square-root suborder has additive index two in QNF's
half-integer order, not only after realization in the complex plane. -/
theorem sqrtOrderToHalfOrder_index (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    (sqrtOrderToHalfOrder p k hk).toRingHom.range.toAddSubgroup.index = 2 := by
  let H := (sqrtOrderToHalfOrder p k hk).toRingHom.range.toAddSubgroup
  let F := (halfOrderEmbedding p k hk).toRingHom.toAddMonoidHom
  have hm : H.map F = (sqrtOrderEmbedding p).toRingHom.range.toAddSubgroup := by
    ext z
    rw [AddSubgroup.mem_map]
    change (∃ y : ZOnePlusSqrtdOverTwo k, y ∈ H ∧ F y = z) ↔
      ∃ x : QuadraticNumberFields.Zsqrtd (-(p : ℤ)), sqrtOrderEmbedding p x = z
    constructor
    · rintro ⟨y, hy, hyz⟩
      obtain ⟨x, hxy⟩ := hy
      change sqrtOrderToHalfOrder p k hk x = y at hxy
      subst y
      refine ⟨x, ?_⟩
      change halfOrderEmbedding p k hk (sqrtOrderToHalfOrder p k hk x) = z at hyz
      rwa [halfOrderEmbedding_comp_sqrtOrderToHalfOrder] at hyz
    · rintro ⟨x, hx⟩
      refine ⟨sqrtOrderToHalfOrder p k hk x, ⟨x, rfl⟩, ?_⟩
      change halfOrderEmbedding p k hk (sqrtOrderToHalfOrder p k hk x) = z
      rwa [halfOrderEmbedding_comp_sqrtOrderToHalfOrder]
  have htop : (⊤ : AddSubgroup (ZOnePlusSqrtdOverTwo k)).map F =
      (halfOrderEmbedding p k hk).toRingHom.range.toAddSubgroup := by
    ext z
    rw [AddSubgroup.mem_map]
    simp only [AddSubgroup.mem_top, true_and]
    rfl
  have hi := AddSubgroup.relIndex_map_map_of_injective (f := F) H ⊤
    (halfOrderEmbedding_injective p k hk)
  rw [hm, htop, AddSubgroup.relIndex_top_right] at hi
  exact hi.symm.trans (sqrtOrder_halfOrder_relIndex p k hk)

/-- The actual half-integer order is a domain in this imaginary quadratic
branch, independently of squarefreeness. -/
theorem halfOrder_isDomain (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    IsDomain (ZOnePlusSqrtdOverTwo k) :=
  Function.Injective.isDomain (halfOrderEmbedding p k hk).toRingHom
    (halfOrderEmbedding_injective p k hk)

/-- The half-integral generator is not in the actual square-root suborder
inside the complex plane. -/
theorem halfPeriod_not_mem_sqrtOrderEmbedding_range (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) :
    (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2 ∉
      (sqrtOrderEmbedding p).toRingHom.range := by
  rintro ⟨z, hz⟩
  have heq : sqrtOrderToHalfOrder p k hk z = QuadraticAlgebra.omega := by
    apply halfOrderEmbedding_injective p k hk
    rw [halfOrderEmbedding_comp_sqrtOrderToHalfOrder, halfOrderEmbedding_omega]
    exact hz
  have hcoords := (sqrtOrderToHalfOrder_coordinates p k hk z).2
  rw [heq] at hcoords
  change (1 : ℤ) = 2 * z.im at hcoords
  omega

end BakerHeegnerStark
