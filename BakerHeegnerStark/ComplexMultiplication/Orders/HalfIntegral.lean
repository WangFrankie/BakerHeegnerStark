import BakerHeegnerStark.EllipticFunctions.PeriodLattice.Basic
import QuadraticNumberFields.ZOnePlusSqrtdOverTwo.Conductor
import Mathlib.Algebra.Ring.Hom.InjSurj

/-!
# The Half-Integral Quadratic Order

For `-p = 1 + 4k`, QNF's model `ZOnePlusSqrtdOverTwo k` realizes the period
module generated by `1` and `(1+i√p)/2`. QNF supplies the square-root suborder
inclusion `√-p ↦ 2ω-1`, its additive index, and its conductor. The local
results identify its complex realization and the corresponding period lattices;
identifying the larger order with the full ring of integers additionally
requires the squarefree hypothesis and QNF's ring-of-integers classification.
-/

open scoped Pointwise QuadraticAlgebra

namespace BakerHeegnerStark

/-- The half-integral complex period satisfies the defining monic relation
of QNF's half-integer order. -/
theorem halfPeriod_quadratic (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    let τ : ℂ := (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2
    τ ^ 2 = (k : ℂ) + τ := by
  dsimp only
  have hs : ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) ^ 2 = -(p : ℂ) := by
    rw [mul_pow, Complex.I_sq, ← Complex.ofReal_pow, Real.sq_sqrt (Nat.cast_nonneg p)]
    push_cast
    ring
  have hkc : -(p : ℂ) = 1 + 4 * (k : ℂ) := by exact_mod_cast hk
  linear_combination (1 / 4 : ℂ) * hs + (1 / 4 : ℂ) * hkc

/-- The faithful branch of the complex realization of QNF's half-integer order. -/
noncomputable def halfOrderEmbedding (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    ZOnePlusSqrtdOverTwo k →ₐ[ℤ] ℂ :=
  QuadraticAlgebra.lift ⟨(1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2, by
    simpa [Algebra.smul_def, pow_two] using halfPeriod_quadratic p k hk⟩

/-- The realization uses the actual two integer coordinates of the order model. -/
theorem halfOrderEmbedding_apply (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (z : ZOnePlusSqrtdOverTwo k) :
    halfOrderEmbedding p k hk z = (z.re : ℂ) + (z.im : ℂ) *
      ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2) := by
  simp [halfOrderEmbedding, QuadraticAlgebra.lift, Algebra.smul_def]

/-- The distinguished half-integer root goes to the chosen complex half-period. -/
theorem halfOrderEmbedding_omega (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    halfOrderEmbedding p k hk QuadraticAlgebra.omega =
      (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2 := by
  simp [halfOrderEmbedding_apply]

/-- The image of the half-integer order is exactly its period module. -/
theorem mem_halfOrderEmbedding_range_iff (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k)
    (α : ℂ) :
    α ∈ (halfOrderEmbedding p k hk).toRingHom.range ↔
      α ∈ periodModule ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2) := by
  constructor
  · rintro ⟨z, rfl⟩
    exact (mem_periodModule_iff _ _).mpr ⟨z.re, z.im, halfOrderEmbedding_apply p k hk z⟩
  · intro h
    obtain ⟨m, n, hα⟩ := (mem_periodModule_iff _ α).mp h
    refine ⟨⟨m, n⟩, ?_⟩
    change halfOrderEmbedding p k hk (⟨m, n⟩ : ZOnePlusSqrtdOverTwo k) = α
    rw [halfOrderEmbedding_apply, hα]

/-- The half-integer realization is injective; its parameter relation already
forces `p > 0`. -/
theorem halfOrderEmbedding_injective (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    Function.Injective (halfOrderEmbedding p k hk) := by
  have hp : 0 < p := by omega
  have him : ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2).im ≠ 0 := by
    have hs := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hp : (0 : ℝ) < (p : ℝ))
    simpa using ne_of_gt (div_pos hs (by norm_num : (0 : ℝ) < 2))
  intro x y h
  rw [halfOrderEmbedding_apply, halfOrderEmbedding_apply] at h
  have hxy := periodModule_coordinates_eq _ him h
  exact QuadraticAlgebra.ext hxy.1 hxy.2

/-- The two concrete complex realizations commute with the actual suborder inclusion. -/
theorem halfOrderEmbedding_comp_fromZsqrtd (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) (z : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) :
    halfOrderEmbedding p k hk (ZOnePlusSqrtdOverTwo.fromZsqrtd k hk z) =
      sqrtOrderEmbedding p z := by
  rw [ZOnePlusSqrtdOverTwo.fromZsqrtd_apply, map_add, map_mul, map_sub, map_mul, map_intCast,
    map_intCast, map_ofNat, map_one, halfOrderEmbedding_omega, sqrtOrderEmbedding_apply]
  ring

/-- The realized square-root order is a subring of the realized half-integer order. -/
theorem sqrtOrder_halfOrder_range_le (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    (sqrtOrderEmbedding p).toRingHom.range ≤ (halfOrderEmbedding p k hk).toRingHom.range := by
  rintro z ⟨x, rfl⟩
  refine ⟨ZOnePlusSqrtdOverTwo.fromZsqrtd k hk x, ?_⟩
  exact halfOrderEmbedding_comp_fromZsqrtd p k hk x

/-- The two faithful complex order images have relative additive index two. -/
theorem sqrtOrder_halfOrder_relIndex (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    (sqrtOrderEmbedding p).toRingHom.range.toAddSubgroup.relIndex
      (halfOrderEmbedding p k hk).toRingHom.range.toAddSubgroup = 2 := by
  let s : ℂ := (Real.sqrt (p : ℝ) : ℂ) * Complex.I
  have hsmall : (sqrtOrderEmbedding p).toRingHom.range.toAddSubgroup =
      (periodModule s).toAddSubgroup := by
    ext z
    exact mem_sqrtOrderEmbedding_range_iff p z
  have hlarge : (halfOrderEmbedding p k hk).toRingHom.range.toAddSubgroup =
      (periodModule ((1 + s) / 2)).toAddSubgroup := by
    ext z
    exact mem_halfOrderEmbedding_range_iff p k hk z
  have hp : 0 < p := by omega
  have him : ((1 + s) / 2).im ≠ 0 := by
    have hs : 0 < s.im := by
      simpa [s] using Real.sqrt_pos.mpr (Nat.cast_pos.mpr hp : (0 : ℝ) < (p : ℝ))
    simpa using ne_of_gt (div_pos hs (by norm_num : (0 : ℝ) < 2))
  have heq : (-1 : ℂ) + 2 * ((1 + s) / 2) = s := by ring
  rw [hsmall, hlarge]
  simpa [heq] using periodModule_affine_relIndex ((1 + s) / 2) him (-1) 2 (by norm_num)

/-- The actual half-integer order is a domain in this imaginary quadratic
branch, independently of squarefreeness. -/
theorem halfOrder_isDomain (p : ℕ) (k : ℤ) (hk : -(p : ℤ) = 1 + 4 * k) :
    IsDomain (ZOnePlusSqrtdOverTwo k) :=
  Function.Injective.isDomain (halfOrderEmbedding p k hk).toRingHom
    (halfOrderEmbedding_injective p k hk)

/-- The half-integral generator is not in the actual square-root suborder
inside the complex plane. -/
theorem halfPeriod_not_mem_sqrtOrderEmbedding_range (p : ℕ) (k : ℤ)
    (hk : -(p : ℤ) = 1 + 4 * k) :
    (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 2 ∉
      (sqrtOrderEmbedding p).toRingHom.range := by
  rintro ⟨z, hz⟩
  have heq : ZOnePlusSqrtdOverTwo.fromZsqrtd k hk z = QuadraticAlgebra.omega := by
    apply halfOrderEmbedding_injective p k hk
    rw [halfOrderEmbedding_comp_fromZsqrtd, halfOrderEmbedding_omega]
    exact hz
  have hcoords := ZOnePlusSqrtdOverTwo.fromZsqrtd_im k hk z
  rw [heq] at hcoords
  change (1 : ℤ) = 2 * z.im at hcoords
  omega

end BakerHeegnerStark
