import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.Real.Sqrt
import Mathlib.LinearAlgebra.Span.Defs
import Mathlib.RingTheory.Int.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Linarith
import QuadraticNumberFields.Zsqrtd.Basic

/-!
# Quadratic Period Modules and Their Multipliers

A period module is the integer span of `1` and a complex parameter. For an
integral quadratic parameter, its complex multipliers are exactly the module
itself. The result below identifies the multipliers of `ℤ + ℤ√-p` concretely;
it does not assert a class-number or CM-value correspondence.
-/

namespace BakerHeegnerStark

/-- The integer period module generated by `1` and a complex parameter.
Discreteness is not part of this definition. -/
def periodModule (τ : ℂ) : Submodule ℤ ℂ :=
  Submodule.span ℤ ({1, τ} : Set ℂ)

/-- Membership in the period module is an integer linear combination of its generators. -/
theorem mem_periodModule_iff (τ z : ℂ) :
    z ∈ periodModule τ ↔ ∃ m n : ℤ, z = (m : ℂ) + (n : ℂ) * τ := by
  simp only [periodModule, Submodule.mem_span_pair, zsmul_eq_mul, mul_one, eq_comm]

/-- For a monic integral quadratic parameter, preserving the period module is
exactly membership in it. -/
theorem mul_preserves_periodModule_iff (τ α : ℂ) (u v : ℤ)
    (hτ : τ ^ 2 = (u : ℂ) + (v : ℂ) * τ) :
    (∀ z ∈ periodModule τ, α * z ∈ periodModule τ) ↔ α ∈ periodModule τ := by
  constructor
  · intro h
    have h1 : (1 : ℂ) ∈ periodModule τ := Submodule.subset_span (by simp)
    simpa using h 1 h1
  · intro hα z hz
    rcases (mem_periodModule_iff τ α).mp hα with ⟨m, n, rfl⟩
    rcases (mem_periodModule_iff τ z).mp hz with ⟨r, s, rfl⟩
    apply (mem_periodModule_iff τ _).mpr
    refine ⟨m * r + n * s * u, m * s + n * r + n * s * v, ?_⟩
    push_cast
    calc
      ((m : ℂ) + n * τ) * (r + s * τ) =
          m * r + n * s * τ ^ 2 + (m * s + n * r) * τ := by ring
      _ = _ := by rw [hτ]; ring

/-- The multipliers of the period module `ℤ + ℤ(i√p)` are precisely `ℤ + ℤ(i√p)`. -/
theorem mul_preserves_sqrt_periodModule_iff (p : ℕ) (α : ℂ) :
    (∀ z ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I),
      α * z ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I)) ↔
      ∃ m n : ℤ, α = (m : ℂ) + (n : ℂ) * ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  rw [mul_preserves_periodModule_iff _ α (-(p : ℤ)) 0, mem_periodModule_iff]
  rw [mul_pow, Complex.I_sq, ← Complex.ofReal_pow,
    Real.sq_sqrt (Nat.cast_nonneg p)]
  push_cast
  ring

/-- Integer coordinates in a period module with a nonreal parameter are unique. -/
theorem periodModule_coordinates_eq (τ : ℂ) (hτ : τ.im ≠ 0)
    {a b c d : ℤ} (h : (a : ℂ) + (b : ℂ) * τ = (c : ℂ) + (d : ℂ) * τ) :
    a = c ∧ b = d := by
  have hi := congrArg Complex.im h
  simp only [Complex.add_im, Complex.intCast_im, Complex.mul_im,
    Complex.intCast_re, zero_mul, zero_add, add_zero] at hi
  have hbd : b = d := by
    exact_mod_cast (mul_right_cancel₀ hτ hi)
  subst d
  have hac : (a : ℂ) = (c : ℂ) := add_right_cancel h
  exact ⟨by exact_mod_cast hac, rfl⟩

/-- For a primitive quadratic relation with leading coefficient four and odd
constant coefficient, the multipliers are generated by `1` and `4τ`. -/
theorem mul_preserves_periodModule_four_iff (τ α : ℂ) (hτim : τ.im ≠ 0)
    (k c : ℤ) (hc : Odd c)
    (hτ : 4 * τ ^ 2 = 2 * (k : ℂ) * τ - (c : ℂ)) :
    (∀ z ∈ periodModule τ, α * z ∈ periodModule τ) ↔
      α ∈ periodModule (4 * τ) := by
  constructor
  · intro h
    have h1 : (1 : ℂ) ∈ periodModule τ := Submodule.subset_span (by simp)
    have ht : τ ∈ periodModule τ := Submodule.subset_span (by simp)
    obtain ⟨m, n, hα⟩ := (mem_periodModule_iff τ α).mp (by simpa using h 1 h1)
    obtain ⟨r, s, hrs⟩ := (mem_periodModule_iff τ (α * τ)).mp (h τ ht)
    have heq : ((-n * c : ℤ) : ℂ) + ((4 * m + 2 * k * n : ℤ) : ℂ) * τ =
        ((4 * r : ℤ) : ℂ) + ((4 * s : ℤ) : ℂ) * τ := by
      push_cast
      rw [hα] at hrs
      linear_combination 4 * hrs - (n : ℂ) * hτ
    have hconstant := (periodModule_coordinates_eq τ hτim heq).1
    have hdiv : (4 : ℤ) ∣ c * n := ⟨-r, by nlinarith [hconstant]⟩
    have hcop2 : IsCoprime (2 : ℤ) c := Int.isCoprime_two_left.mpr hc
    have hcop4 : IsCoprime (4 : ℤ) c := by
      simpa using hcop2.mul_left hcop2
    obtain ⟨q, hq⟩ := hcop4.dvd_of_dvd_mul_left hdiv
    apply (mem_periodModule_iff (4 * τ) α).mpr
    refine ⟨m, q, ?_⟩
    rw [hα, hq]
    push_cast
    ring
  · intro hα z hz
    obtain ⟨m, n, hα⟩ := (mem_periodModule_iff (4 * τ) α).mp hα
    obtain ⟨r, s, hz⟩ := (mem_periodModule_iff τ z).mp hz
    apply (mem_periodModule_iff τ (α * z)).mpr
    refine ⟨m * r - n * s * c, m * s + 4 * n * r + 2 * n * s * k, ?_⟩
    rw [hα, hz]
    push_cast
    linear_combination (n : ℂ) * (s : ℂ) * hτ

/-- An integral translation does not change a period module. -/
theorem periodModule_add_int (τ : ℂ) (k : ℤ) :
    periodModule ((k : ℂ) + τ) = periodModule τ := by
  ext z
  rw [mem_periodModule_iff, mem_periodModule_iff]
  constructor
  · rintro ⟨m, n, rfl⟩
    refine ⟨m + n * k, n, ?_⟩
    push_cast
    ring
  · rintro ⟨m, n, rfl⟩
    refine ⟨m - n * k, n, ?_⟩
    push_cast
    ring

/-- An odd constant coefficient in the quadratic relation identifies the
multipliers of the quarter parameter with `ℤ + ℤ(i√p)`. -/
theorem mul_preserves_quarter_periodModule_iff
    (p : ℕ) (hp : 0 < p) (k c : ℤ) (hc : Odd c)
    (heq : 4 * c = k ^ 2 + (p : ℤ)) (α : ℂ) :
    (∀ z ∈ periodModule (((k : ℂ) + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4),
      α * z ∈ periodModule (((k : ℂ) + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4)) ↔
      α ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  let s : ℂ := (Real.sqrt (p : ℝ) : ℂ) * Complex.I
  let τ : ℂ := ((k : ℂ) + s) / 4
  have hs : s ^ 2 = -(p : ℂ) := by
    dsimp [s]
    rw [mul_pow, Complex.I_sq, ← Complex.ofReal_pow, Real.sq_sqrt (Nat.cast_nonneg p)]
    push_cast
    ring
  have hτim : τ.im ≠ 0 := by
    have hpos : 0 < τ.im := by
      simpa [τ, s] using div_pos (Real.sqrt_pos.mpr
        (by exact_mod_cast hp : (0 : ℝ) < (p : ℝ)))
        (by norm_num : (0 : ℝ) < 4)
    exact ne_of_gt hpos
  have heq' : 4 * (c : ℂ) = (k : ℂ) ^ 2 + (p : ℂ) := by exact_mod_cast heq
  have hτ : 4 * τ ^ 2 = 2 * (k : ℂ) * τ - (c : ℂ) := by
    dsimp [τ]
    linear_combination (1 / 4 : ℂ) * hs + (1 / 4 : ℂ) * heq'
  change (∀ z ∈ periodModule τ, α * z ∈ periodModule τ) ↔ α ∈ periodModule s
  rw [mul_preserves_periodModule_four_iff τ α hτim k c hc hτ]
  have ht : 4 * τ = (k : ℂ) + s := by dsimp [τ]; ring
  rw [ht, periodModule_add_int]

/-- For `p ≡ 3 mod 8`, the quarter parameter `(1+i√p)/4` has multiplier
module `ℤ + ℤ(i√p)`. -/
theorem mul_preserves_inert_half_periodModule_iff (p : ℕ) (hp8 : p % 8 = 3) (α : ℂ) :
    (∀ z ∈ periodModule ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4),
      α * z ∈ periodModule ((1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4)) ↔
      α ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  have heq : 4 * (((p : ℤ) + 1) / 4) = (1 : ℤ) ^ 2 + (p : ℤ) := by omega
  have hodd : Odd (((p : ℤ) + 1) / 4) := Int.odd_iff.mpr (by omega)
  simpa using mul_preserves_quarter_periodModule_iff p (by omega) 1
    (((p : ℤ) + 1) / 4) hodd heq α

/-- For `p ≡ 3 mod 8`, the shifted quarter parameter `(3+i√p)/4` has
multiplier module `ℤ + ℤ(i√p)`. -/
theorem mul_preserves_inert_shifted_half_periodModule_iff
    (p : ℕ) (hp8 : p % 8 = 3) (α : ℂ) :
    (∀ z ∈ periodModule ((3 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4),
      α * z ∈ periodModule ((3 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) / 4)) ↔
      α ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  have heq : 4 * (((p : ℤ) + 9) / 4) = (3 : ℤ) ^ 2 + (p : ℤ) := by omega
  have hodd : Odd (((p : ℤ) + 9) / 4) := Int.odd_iff.mpr (by omega)
  simpa using mul_preserves_quarter_periodModule_iff p (by omega) 3
    (((p : ℤ) + 9) / 4) hodd heq α

/-- The integral translate `1+i√p` has the same multiplier module as `i√p`. -/
theorem mul_preserves_inert_double_periodModule_iff (p : ℕ) (α : ℂ) :
    (∀ z ∈ periodModule (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I),
      α * z ∈ periodModule (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I)) ↔
      α ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  have ht : periodModule (1 + (Real.sqrt (p : ℝ) : ℂ) * Complex.I) =
      periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
    simpa using periodModule_add_int ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) 1
  rw [ht]
  exact (mul_preserves_sqrt_periodModule_iff p α).trans
    (mem_periodModule_iff _ α).symm

/-- The concrete complex realization of QNF's `ℤ[√-p]` model. -/
noncomputable def sqrtOrderEmbedding (p : ℕ) :
    QuadraticNumberFields.Zsqrtd (-(p : ℤ)) →ₐ[ℤ] ℂ := by
  refine QuadraticAlgebra.lift
    ⟨(Real.sqrt (p : ℝ) : ℂ) * Complex.I, ?_⟩
  simp only [Algebra.smul_def, mul_one]
  rw [← pow_two, mul_pow, Complex.I_sq, ← Complex.ofReal_pow,
    Real.sq_sqrt (Nat.cast_nonneg p)]
  push_cast
  ring

/-- The realization sends the two QNF coordinates to the corresponding complex period. -/
theorem sqrtOrderEmbedding_apply (p : ℕ) (z : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) :
    sqrtOrderEmbedding p z =
      (z.re : ℂ) + (z.im : ℂ) * ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  simp [sqrtOrderEmbedding, QuadraticAlgebra.lift, Algebra.smul_def]

/-- The realized quadratic order is exactly the computed multiplier module. -/
theorem mem_sqrtOrderEmbedding_range_iff (p : ℕ) (α : ℂ) :
    α ∈ (sqrtOrderEmbedding p).toRingHom.range ↔
      α ∈ periodModule ((Real.sqrt (p : ℝ) : ℂ) * Complex.I) := by
  constructor
  · rintro ⟨z, rfl⟩
    apply (mem_periodModule_iff _ _).mpr
    exact ⟨z.re, z.im, sqrtOrderEmbedding_apply p z⟩
  · intro h
    obtain ⟨m, n, hα⟩ := (mem_periodModule_iff _ α).mp h
    refine ⟨⟨m, n⟩, ?_⟩
    change sqrtOrderEmbedding p (⟨m, n⟩ : QuadraticNumberFields.Zsqrtd (-(p : ℤ))) = α
    rw [sqrtOrderEmbedding_apply, hα]

/-- The complex realization is injective when `p` is positive. -/
theorem sqrtOrderEmbedding_injective (p : ℕ) (hp : 0 < p) :
    Function.Injective (sqrtOrderEmbedding p) := by
  intro x y h
  rw [sqrtOrderEmbedding_apply, sqrtOrderEmbedding_apply] at h
  have hs : ((Real.sqrt (p : ℝ) : ℂ) * Complex.I).im ≠ 0 := by
    simpa using ne_of_gt (Real.sqrt_pos.mpr (by exact_mod_cast hp : (0 : ℝ) < (p : ℝ)))
  have hxy := periodModule_coordinates_eq _ hs h
  exact QuadraticAlgebra.ext hxy.1 hxy.2

/-- The three parameters over the inert residue family have the actual QNF
quadratic-order image as their common multiplier ring, expressed elementwise. -/
theorem inert_periodModule_multipliers (p : ℕ) (hp8 : p % 8 = 3) (α : ℂ) :
    let s : ℂ := (Real.sqrt (p : ℝ) : ℂ) * Complex.I
    ((∀ z ∈ periodModule (1 + s), α * z ∈ periodModule (1 + s)) ↔
      α ∈ (sqrtOrderEmbedding p).toRingHom.range) ∧
    ((∀ z ∈ periodModule ((1 + s) / 4), α * z ∈ periodModule ((1 + s) / 4)) ↔
      α ∈ (sqrtOrderEmbedding p).toRingHom.range) ∧
    ((∀ z ∈ periodModule ((3 + s) / 4), α * z ∈ periodModule ((3 + s) / 4)) ↔
      α ∈ (sqrtOrderEmbedding p).toRingHom.range) := by
  dsimp only
  exact ⟨(mul_preserves_inert_double_periodModule_iff p α).trans
      (mem_sqrtOrderEmbedding_range_iff p α).symm,
    (mul_preserves_inert_half_periodModule_iff p hp8 α).trans
      (mem_sqrtOrderEmbedding_range_iff p α).symm,
    (mul_preserves_inert_shifted_half_periodModule_iff p hp8 α).trans
      (mem_sqrtOrderEmbedding_range_iff p α).symm⟩

end BakerHeegnerStark
