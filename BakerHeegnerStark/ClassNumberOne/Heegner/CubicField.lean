import BakerHeegnerStark.ClassNumberOne.Heegner.Algebra
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The Field Generated by Heegner's Cubic Root

The root of `W³ - γW - 16`, for an integer `γ < -15`, generates a cubic field.
Its associated rational Weber j-expression generates the same field: its degree
divides three, and a quadratic remainder excludes a rational j-value.

For Heegner's actual quantity this concerns its fourth power only. It does not
assert that taking a fourth root preserves the field.

## Reference

D. A. Cox, *Primes of the form x² + ny²*, 2nd ed., §12.C (Heegner's argument).
-/

open Polynomial IntermediateField
namespace BakerHeegnerStark

private theorem integral_heegnerCubic_root {γ : ℤ} {w : ℂ}
    (hw : w ^ 3 - γ * w - 16 = 0) : IsIntegral ℚ w := by
  let P : ℚ[X] := X ^ 3 - C (γ : ℚ) * X - C 16
  have hroot : aeval w P = 0 := by simpa [P] using hw
  exact ⟨P, by dsimp [P]; monicity!, by rwa [aeval_def] at hroot⟩

/-- An actual root of the irreducible Heegner cubic generates a cubic field. -/
theorem finrank_adjoin_heegnerCubic_root {γ : ℤ} {w : ℂ}
    (hγ : γ < -15) (hw : w ^ 3 - γ * w - 16 = 0) :
    Module.finrank ℚ ℚ⟮w⟯ = 3 := by
  have hint := integral_heegnerCubic_root hw
  have hmin : (X ^ 3 - C (γ : ℚ) * X - C 16 : ℚ[X]) = minpoly ℚ w :=
    minpoly.eq_of_irreducible_of_monic (irreducible_heegnerGammaCubic γ hγ)
      (by simpa using hw) (by monicity!)
  rw [IntermediateField.adjoin.finrank hint, ← hmin]
  compute_degree!

/-- The rational Weber j-expression in a Heegner cubic root generates the same
field as that root. Coefficient comparison rules out the rational subfield. -/
theorem adjoin_heegnerCubic_root_eq_adjoin_j {γ : ℤ} {w j : ℂ}
    (hγ : γ < -15) (hw : w ^ 3 - γ * w - 16 = 0)
    (hj : j * w ^ 6 = (256 - w ^ 3) ^ 3) :
    ℚ⟮w⟯ = ℚ⟮j⟯ := by
  have hint := integral_heegnerCubic_root hw
  have : FiniteDimensional ℚ ℚ⟮w⟯ := IntermediateField.adjoin.finiteDimensional hint
  have hdegree := finrank_adjoin_heegnerCubic_root hγ hw
  have hw0 : w ≠ 0 := by intro h; simp [h] at hw
  have hw3 : w ^ 3 = (γ : ℂ) * w + 16 := by linear_combination hw
  have hw6 : w ^ 6 = ((γ : ℂ) * w + 16) ^ 2 := by
    calc
      w ^ 6 = (w ^ 3) ^ 2 := by ring
      _ = _ := by rw [hw3]
  have hjmem : j ∈ ℚ⟮w⟯ := by
    rw [(eq_div_iff (pow_ne_zero 6 hw0)).mpr hj]
    exact (ℚ⟮w⟯).div_mem
      ((ℚ⟮w⟯).pow_mem ((ℚ⟮w⟯).sub_mem (by simp)
        ((ℚ⟮w⟯).pow_mem (mem_adjoin_simple_self ℚ w) 3)) 3)
      ((ℚ⟮w⟯).pow_mem (mem_adjoin_simple_self ℚ w) 6)
  have hle : ℚ⟮j⟯ ≤ ℚ⟮w⟯ := adjoin_simple_le_iff.mpr hjmem
  have hdiv : Module.finrank ℚ ℚ⟮j⟯ ∣ 3 := by
    simpa only [hdegree] using finrank_dvd_of_le_right hle
  have hjdegree : Module.finrank ℚ ℚ⟮j⟯ = 3 := by
    rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hdiv with h1 | h3
    · obtain ⟨r, hr⟩ := mem_bot.mp (finrank_adjoin_simple_eq_one_iff.mp h1)
      change (r : ℂ) = j at hr
      let R : ℚ[X] := C ((γ : ℚ) ^ 2 * (r - 720)) * X ^ 2 +
        C ((γ : ℚ) * (32 * r + 172800 + (γ : ℚ) ^ 3)) * X +
        C (256 * r - 13824000 + 16 * (γ : ℚ) ^ 3)
      have hR : aeval w R = 0 := by
        simp only [R, map_add, map_mul, map_pow, aeval_C, aeval_X, eq_ratCast]
        push_cast
        have hj' := hj
        rw [← hr, hw6, hw3] at hj'
        linear_combination hj' - (γ : ℂ) ^ 3 * hw
      have hRdeg : R.natDegree ≤ 2 := by
        dsimp only [R]
        compute_degree!
      have hRzero : R = 0 := by
        by_contra hRne
        have hd := natDegree_le_of_dvd (minpoly.dvd ℚ w hR) hRne
        rw [← IntermediateField.adjoin.finrank hint, hdegree] at hd
        omega
      have hc2 := congrArg (fun P : ℚ[X] => P.coeff 2) hRzero
      have hc1 := congrArg (fun P : ℚ[X] => P.coeff 1) hRzero
      have hc0 := congrArg (fun P : ℚ[X] => P.coeff 0) hRzero
      simp only [R, coeff_add, coeff_C_mul, coeff_X_pow, coeff_X, coeff_C,
        coeff_zero] at hc2 hc1 hc0
      norm_num at hc2 hc1 hc0
      have hγ0 : γ ≠ 0 := by omega
      have hr720 : r = 720 :=
        sub_eq_zero.mp (hc2.resolve_left hγ0)
      rw [hr720] at hc1 hc0
      have hcube := hc1.resolve_left hγ0
      linarith
    · exact h3
  exact (eq_of_le_of_finrank_eq hle (hjdegree.trans hdegree.symm)).symm

end BakerHeegnerStark
