import BakerHeegnerStark.EllipticCurves.JInvariant.Uniformization

/-!
# Arithmetic translation parameters of the actual complex normalization

The chosen complex change from the j-generated coefficient model to the
short period equation has translation parameters determined by the original
coefficients. These three parameters belong to the actual field `ℚ(j(τ))`,
without any CM or number-field assumption. The scaling unit remains complex;
no field of definition for it is asserted.

The finite y-coordinate formula absorbs the translation terms into the
original model's coefficients and the transformed x-coordinate.
-/

open scoped IntermediateField

namespace BakerHeegnerStark

/-- The x-translation of the chosen normalization is determined by the original `b₂`. -/
theorem jInvariantCurveChange_r_eq (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).r = -((jInvariantCurve τ).baseChange ℂ).b₂ / 12 := by
  have h := congrArg WeierstrassCurve.b₂ (jInvariantCurveChange_smul τ)
  rw [WeierstrassCurve.variableChange_b₂] at h
  have hb : (periodCurve (standardPeriodPair τ)).b₂ = 0 := by
    simp [periodCurve, WeierstrassCurve.b₂]
  rw [hb] at h
  have hz := (mul_eq_zero.mp h).resolve_left (pow_ne_zero 2 (Units.ne_zero _))
  linear_combination hz / 12

/-- The shear of the chosen normalization is determined by the original `a₁`. -/
theorem jInvariantCurveChange_s_eq (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).s = -((jInvariantCurve τ).baseChange ℂ).a₁ / 2 := by
  have h := congrArg WeierstrassCurve.a₁ (jInvariantCurveChange_smul τ)
  rw [WeierstrassCurve.variableChange_a₁] at h
  have ha : (periodCurve (standardPeriodPair τ)).a₁ = 0 := rfl
  rw [ha] at h
  have hz := (mul_eq_zero.mp h).resolve_left (Units.ne_zero _)
  linear_combination hz / 2

/-- The y-translation is determined by the original coefficients and x-translation. -/
theorem jInvariantCurveChange_t_eq (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).t =
      -(((jInvariantCurve τ).baseChange ℂ).a₃ +
        (jInvariantCurveChange τ).r * ((jInvariantCurve τ).baseChange ℂ).a₁) / 2 := by
  have h := congrArg WeierstrassCurve.a₃ (jInvariantCurveChange_smul τ)
  rw [WeierstrassCurve.variableChange_a₃] at h
  have ha : (periodCurve (standardPeriodPair τ)).a₃ = 0 := rfl
  rw [ha] at h
  have hz := (mul_eq_zero.mp h).resolve_left (pow_ne_zero 3 (Units.ne_zero _))
  linear_combination hz / 2

/-- The actual x-translation lies in the field generated by the analytic j-value. -/
theorem jInvariantCurveChange_r_mem (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).r ∈ ℚ⟮ModularForm.jInvariant τ⟯ := by
  rw [jInvariantCurveChange_r_eq, WeierstrassCurve.baseChange, WeierstrassCurve.map_b₂]
  exact (ℚ⟮ModularForm.jInvariant τ⟯).div_mem
    ((ℚ⟮ModularForm.jInvariant τ⟯).neg_mem (jInvariantCurve τ).b₂.property)
    ((ℚ⟮ModularForm.jInvariant τ⟯).natCast_mem 12)

/-- The actual shear lies in the field generated by the analytic j-value. -/
theorem jInvariantCurveChange_s_mem (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).s ∈ ℚ⟮ModularForm.jInvariant τ⟯ := by
  rw [jInvariantCurveChange_s_eq]
  exact (ℚ⟮ModularForm.jInvariant τ⟯).div_mem
    ((ℚ⟮ModularForm.jInvariant τ⟯).neg_mem (jInvariantCurve τ).a₁.property)
    ((ℚ⟮ModularForm.jInvariant τ⟯).natCast_mem 2)

/-- The actual y-translation lies in the field generated by the analytic j-value. -/
theorem jInvariantCurveChange_t_mem (τ : UpperHalfPlane) :
    (jInvariantCurveChange τ).t ∈ ℚ⟮ModularForm.jInvariant τ⟯ := by
  rw [jInvariantCurveChange_t_eq]
  exact (ℚ⟮ModularForm.jInvariant τ⟯).div_mem
    ((ℚ⟮ModularForm.jInvariant τ⟯).neg_mem
      ((ℚ⟮ModularForm.jInvariant τ⟯).add_mem (jInvariantCurve τ).a₃.property
        ((ℚ⟮ModularForm.jInvariant τ⟯).mul_mem (jInvariantCurveChange_r_mem τ)
          (jInvariantCurve τ).a₁.property)))
    ((ℚ⟮ModularForm.jInvariant τ⟯).natCast_mem 2)

/-- The actual finite y-coordinate has its translation expressed in original-model coordinates. -/
theorem jInvariantCurveChange_pointY (τ : UpperHalfPlane) (x y : ℂ) :
    (jInvariantCurveChange τ).pointY x y =
      ((jInvariantCurveChange τ).u : ℂ) ^ 3 * y -
        (((jInvariantCurve τ).baseChange ℂ).a₁ * (jInvariantCurveChange τ).pointX x +
          ((jInvariantCurve τ).baseChange ℂ).a₃) / 2 := by
  simp only [WeierstrassCurve.VariableChange.pointY, WeierstrassCurve.VariableChange.pointX,
    jInvariantCurveChange_s_eq, jInvariantCurveChange_t_eq]
  ring

end BakerHeegnerStark
