import BakerHeegnerStark.EllipticCurves.JInvariant.Model
import BakerHeegnerStark.EllipticFunctions.Uniformization.Torsion
import BakerHeegnerStark.EllipticCurves.Weierstrass.Galois
import BakerHeegnerStark.EllipticCurves.Weierstrass.PointChange

/-!
# Actual points of the j-generated coefficient model

A fixed actual complex change of variables identifies the period curve's
existing point group with the complex points of the curve defined over
`ℚ(j(τ))`. The same normalization is used on all torsion subgroups and
retains the ordered division-point coordinates and positive-level count.

The chosen change itself is complex; no arithmetic field of definition
for it or for the transported CM point-group endomorphism is asserted.
-/

namespace BakerHeegnerStark

/-- A fixed actual complex normalization from the j-generated coefficient model to the period curve. -/
noncomputable def jInvariantCurveChange (τ : UpperHalfPlane) : WeierstrassCurve.VariableChange ℂ :=
  Classical.choose (jInvariantCurve_exists_variableChange τ)

/-- The chosen change is a genuine equality of the actual complex equations. -/
theorem jInvariantCurveChange_smul (τ : UpperHalfPlane) :
    jInvariantCurveChange τ • ((jInvariantCurve τ).baseChange ℂ) =
      periodCurve (standardPeriodPair τ) :=
  Classical.choose_spec (jInvariantCurve_exists_variableChange τ)

/-- The period-curve point group is the actual complex point group of the j-generated model. -/
noncomputable def jInvariantCurvePointEquiv [DecidableEq ℂ] (τ : UpperHalfPlane) :
    (periodCurve (standardPeriodPair τ)).toAffine.Point ≃+
      ((jInvariantCurve τ).baseChange ℂ).toAffine.Point := by
  rw [← jInvariantCurveChange_smul τ]
  exact (jInvariantCurveChange τ).pointAddEquiv ((jInvariantCurve τ).baseChange ℂ)

/-- Actual period uniformization with coefficients in the field generated by the analytic j-value. -/
noncomputable def jInvariantCurveTorusEquiv [DecidableEq ℂ] (τ : UpperHalfPlane) :
    PeriodTorus (τ : ℂ) ≃+ ((jInvariantCurve τ).baseChange ℂ).toAffine.Point :=
  (standardPeriodTorusEquiv τ).trans (jInvariantCurvePointEquiv τ)

/-- The same chosen normalization restricts to every actual torsion subgroup. -/
noncomputable def jInvariantCurveTorsionEquiv [DecidableEq ℂ] (τ : UpperHalfPlane) (N : ℕ) :
    PeriodCurveTorsion τ N ≃+ WeierstrassTorsion (jInvariantCurve τ).toAffine ℂ N :=
  (jInvariantCurvePointEquiv τ).torsionByEquiv (N : ℤ)

/-- The torsion map and point map use the same actual complex normalization. -/
@[simp]
theorem jInvariantCurveTorsionEquiv_val [DecidableEq ℂ] (τ : UpperHalfPlane) (N : ℕ)
    (P : PeriodCurveTorsion τ N) :
    (jInvariantCurveTorsionEquiv τ N P : ((jInvariantCurve τ).baseChange ℂ).toAffine.Point) =
      jInvariantCurvePointEquiv τ P := rfl

/-- The specified ordered residue coordinates on the actual j-generated curve's complex torsion. -/
noncomputable def jInvariantCurveTorsionCoordinatesEquiv [DecidableEq ℂ]
    (τ : UpperHalfPlane) (N : ℕ) (hN : 0 < N) :
    (Fin 2 → ZMod N) ≃+ WeierstrassTorsion (jInvariantCurve τ).toAffine ℂ N :=
  (periodCurveTorsionCoordinatesEquiv τ N hN).trans (jInvariantCurveTorsionEquiv τ N)

/-- The actual j-generated coefficient model has `N²` complex torsion points at positive levels. -/
theorem nat_card_jInvariantCurveTorsion [DecidableEq ℂ]
    (τ : UpperHalfPlane) (N : ℕ) (hN : 0 < N) :
    Nat.card (WeierstrassTorsion (jInvariantCurve τ).toAffine ℂ N) = N ^ 2 := by
  calc
    Nat.card (WeierstrassTorsion (jInvariantCurve τ).toAffine ℂ N) =
        Nat.card (PeriodCurveTorsion τ N) :=
      Nat.card_congr (jInvariantCurveTorsionEquiv τ N).symm.toEquiv
    _ = N ^ 2 := nat_card_periodCurveTorsion τ N hN

end BakerHeegnerStark
