import BakerHeegnerStark.EllipticFunctions.Uniformization.Curve
import Mathlib.AlgebraicGeometry.EllipticCurve.ModelsWithJ
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# An Elliptic Curve over the Field Generated by the Analytic j-Invariant

Mathlib's `WeierstrassCurve.ofJ` gives an actual coefficient model over
`ℚ(j(τ))`, uniformly including `j = 0` and `j = 1728`. Its complex base change
has the analytic invariant and hence is carried to the standard period curve
by a complex change of variables. No field membership of the lattice
invariants, CM hypothesis, or finite-dimensionality assertion is needed.
-/

open scoped IntermediateField

namespace BakerHeegnerStark

/-- The analytic modular invariant as an element of its actual generated field. -/
noncomputable def jInvariantFieldElement (τ : UpperHalfPlane) :
    ℚ⟮ModularForm.jInvariant τ⟯ :=
  IntermediateField.AdjoinSimple.gen ℚ (ModularForm.jInvariant τ)

@[simp]
theorem coe_jInvariantFieldElement (τ : UpperHalfPlane) :
    (jInvariantFieldElement τ : ℂ) = ModularForm.jInvariant τ := rfl

/-- An actual elliptic coefficient model over the field generated by `j(τ)`. -/
noncomputable def jInvariantCurve (τ : UpperHalfPlane) :
    WeierstrassCurve ℚ⟮ModularForm.jInvariant τ⟯ := by
  classical
  exact WeierstrassCurve.ofJ (jInvariantFieldElement τ)

/-- The `ofJ` model is nonsingular, including at both exceptional invariant values. -/
instance jInvariantCurve_isElliptic (τ : UpperHalfPlane) :
    (jInvariantCurve τ).IsElliptic := by
  classical
  unfold jInvariantCurve
  infer_instance

/-- Over its coefficient field, the model has the prescribed typed invariant. -/
@[simp]
theorem jInvariantCurve_j (τ : UpperHalfPlane) :
    (jInvariantCurve τ).j = jInvariantFieldElement τ := by
  classical
  exact WeierstrassCurve.ofJ_j (jInvariantFieldElement τ)

/-- Nonsingularity is preserved by the actual inclusion of the coefficient field in `ℂ`. -/
instance jInvariantCurve_baseChange_isElliptic (τ : UpperHalfPlane) :
    ((jInvariantCurve τ).baseChange ℂ).IsElliptic := by
  unfold WeierstrassCurve.baseChange
  infer_instance

/-- Complex base change recovers the actual analytic modular invariant. -/
@[simp]
theorem jInvariantCurve_baseChange_j (τ : UpperHalfPlane) :
    ((jInvariantCurve τ).baseChange ℂ).j = ModularForm.jInvariant τ := by
  change ((jInvariantCurve τ).map
    (algebraMap ℚ⟮ModularForm.jInvariant τ⟯ ℂ)).j = _
  rw [WeierstrassCurve.map_j, jInvariantCurve_j]
  rfl

/-- The complex coefficient model is changed into the actual standard period
curve in the displayed direction, with no restriction on the invariant. -/
theorem jInvariantCurve_exists_variableChange (τ : UpperHalfPlane) :
    ∃ C : WeierstrassCurve.VariableChange ℂ,
      C • ((jInvariantCurve τ).baseChange ℂ) = periodCurve (standardPeriodPair τ) := by
  apply WeierstrassCurve.exists_variableChange_of_j_eq
  rw [jInvariantCurve_baseChange_j, standardPeriodCurve_j]

end BakerHeegnerStark
