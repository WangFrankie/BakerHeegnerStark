import BakerHeegnerStark.ModularForms.ModularPolynomial.QExpansion
import Mathlib.NumberTheory.Cyclotomic.Gal
import Mathlib.RingTheory.RootsOfUnity.Complex

/-!
# The Actual Cyclotomic Coefficient Field

The translation phases of level `N`, and every coefficient of their full
common-width root expansions, lie in the concrete intermediate field
`ℚ(cyclicSublatticePhase 1 N) ⊆ ℂ`. For positive `N` this is a finite Galois
cyclotomic extension. Its automorphisms act on the actual generating phase
by exponents coprime to `N`, including at level one.
-/

noncomputable section

namespace BakerHeegnerStark

/-- The concrete subfield of `ℂ` generated by the common level-`N` phase. -/
def cyclicSublatticeCyclotomicField (N : ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {cyclicSublatticePhase 1 N}

/-- The actual common phase, regarded as an element of its generated field. -/
def cyclicSublatticeCyclotomicRoot (N : ℕ) : cyclicSublatticeCyclotomicField N :=
  ⟨cyclicSublatticePhase 1 N, IntermediateField.mem_adjoin_simple_self ℚ _⟩

@[simp]
theorem coe_cyclicSublatticeCyclotomicRoot (N : ℕ) :
    (cyclicSublatticeCyclotomicRoot N : ℂ) = cyclicSublatticePhase 1 N := rfl

/-- The common phase is a primitive root of the full level, not merely an
`N`-th root of unity. -/
theorem isPrimitiveRoot_cyclicSublatticePhase {N : ℕ} (hN : 0 < N) :
    IsPrimitiveRoot (cyclicSublatticePhase 1 N) N := by
  simpa only [cyclicSublatticePhase, Nat.cast_one, mul_one] using
    Complex.isPrimitiveRoot_exp N (Nat.ne_of_gt hN)

/-- Primitivity holds inside the concrete coefficient field as well. -/
theorem isPrimitiveRoot_cyclicSublatticeCyclotomicRoot {N : ℕ} (hN : 0 < N) :
    IsPrimitiveRoot (cyclicSublatticeCyclotomicRoot N) N :=
  IsPrimitiveRoot.coe_submonoidClass_iff.mp (isPrimitiveRoot_cyclicSublatticePhase hN)

/-- The concrete generated subfield is the level-`N` cyclotomic extension.
Only the generating root is required to be algebraic over `ℚ`. -/
theorem isCyclotomicExtension_cyclicSublatticeCyclotomicField {N : ℕ} (hN : 0 < N) :
    IsCyclotomicExtension {N} ℚ (cyclicSublatticeCyclotomicField N) := by
  let : NeZero N := ⟨Nat.ne_of_gt hN⟩
  exact (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin N ℚ ℂ
    (cyclicSublatticeCyclotomicField N) (isPrimitiveRoot_cyclicSublatticePhase hN)).2 rfl

/-- The actual coefficient field is finite-dimensional over the rationals. -/
theorem finiteDimensional_cyclicSublatticeCyclotomicField {N : ℕ} (hN : 0 < N) :
    FiniteDimensional ℚ (cyclicSublatticeCyclotomicField N) := by
  let := isCyclotomicExtension_cyclicSublatticeCyclotomicField hN
  exact IsCyclotomicExtension.finiteDimensional {N} ℚ (cyclicSublatticeCyclotomicField N)

/-- The actual coefficient field is Galois over the rationals. -/
theorem isGalois_cyclicSublatticeCyclotomicField {N : ℕ} (hN : 0 < N) :
    IsGalois ℚ (cyclicSublatticeCyclotomicField N) := by
  let := isCyclotomicExtension_cyclicSublatticeCyclotomicField hN
  exact IsCyclotomicExtension.isGalois {N} ℚ (cyclicSublatticeCyclotomicField N)

/-- Every cyclic-sublattice translation phase belongs to the concrete common
cyclotomic field. -/
theorem cyclicSublatticePhase_mem_cyclicSublatticeCyclotomicField {N : ℕ}
    (hN : 0 < N) {t : ℕ × ℕ × ℕ} (ht : t ∈ cyclicSublatticeTriples N) :
    cyclicSublatticePhase t.2.1 t.2.2 ∈ cyclicSublatticeCyclotomicField N := by
  rw [cyclicSublatticePhase_commonRoot hN ht]
  exact pow_mem (cyclicSublatticeCyclotomicRoot N).property _

/-- Every coefficient, including all inserted zero coefficients, lies in the
actual coefficient field. This uses field closure, not integrality closure. -/
theorem cyclicSublatticeRootQExpansion_coeff_mem_cyclicSublatticeCyclotomicField
    {N : ℕ} (hN : 0 < N) {t : ℕ × ℕ × ℕ}
    (ht : t ∈ cyclicSublatticeTriples N) (ha : 0 < t.1) (m : ℕ) :
    (cyclicSublatticeRootQExpansion t ha).coeff m ∈ cyclicSublatticeCyclotomicField N := by
  rw [cyclicSublatticeRootQExpansion_coeff]
  split_ifs
  · have hphase := cyclicSublatticePhase_mem_cyclicSublatticeCyclotomicField hN ht
    exact (cyclicSublatticeCyclotomicField N).div_mem
      ((cyclicSublatticeCyclotomicField N).mul_mem
        ((cyclicSublatticeCyclotomicField N).intCast_mem _) (pow_mem hphase _)) hphase
  · exact (cyclicSublatticeCyclotomicField N).zero_mem

/-- Every rational automorphism acts on the actual generating phase by a
coprime exponent. No primality or nontriviality assumption on `N` is needed. -/
theorem exists_coprime_cyclicSublatticeCyclotomicRoot_aut {N : ℕ} (hN : 0 < N)
    (σ : cyclicSublatticeCyclotomicField N ≃ₐ[ℚ] cyclicSublatticeCyclotomicField N) :
    ∃ u : ℕ, Nat.Coprime u N ∧
      σ (cyclicSublatticeCyclotomicRoot N) = cyclicSublatticeCyclotomicRoot N ^ u := by
  let : NeZero N := ⟨Nat.ne_of_gt hN⟩
  let hζ := isPrimitiveRoot_cyclicSublatticeCyclotomicRoot hN
  exact ⟨(hζ.autToPow ℚ σ : ZMod N).val,
    ZMod.val_coe_unit_coprime (hζ.autToPow ℚ σ), (hζ.autToPow_spec ℚ σ).symm⟩

end BakerHeegnerStark
